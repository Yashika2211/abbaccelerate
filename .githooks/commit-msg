#!/bin/bash
# Kairos is a hackathon submission: every commit must be solely authored by
# Yashika2211. Strip any co-author or tooling attribution trailer that slips in.
set -e
msg_file="$1"
grep -v -i -e '^Co-Authored-By:' \
          -e 'Generated with \[Claude Code\]' \
          -e '^Signed-off-by: Claude' "$msg_file" > "$msg_file.tmp"
mv "$msg_file.tmp" "$msg_file"
