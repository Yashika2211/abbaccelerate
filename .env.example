# ---------------------------------------------------------------------------
# Kairos environment. Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- LLM (optional) --------------------------------------------------------
# Without a key Kairos falls back to deterministic rule-based diagnosis and
# template narration. The demo still runs end to end; it is just less clever.
ANTHROPIC_API_KEY=
KAIROS_LLM_MODEL=claude-sonnet-5

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=kairos
POSTGRES_PASSWORD=kairos
POSTGRES_DB=kairos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MLflow ----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=kairos

# --- API -------------------------------------------------------------------
KAIROS_ENV=dev
KAIROS_LOG_LEVEL=INFO
KAIROS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Host port map ---------------------------------------------------------
# Only affects the host side; service-to-service traffic uses the internal ports.
# Defaults dodge the usual macOS squatters: 5000 is AirPlay, and 5432/5433/8000
# are commonly held by other local projects. Change these if `make up` reports
# "port is already allocated".
KAIROS_API_PORT=8010
KAIROS_WEB_PORT=5173
KAIROS_PG_PORT=5434
KAIROS_MLFLOW_PORT=5001
