# ---------------------------------------------------------------------------
# Kairos environment. Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- LLM (optional) --------------------------------------------------------
# Without a key Kairos falls back to deterministic rule-based diagnosis and
# template narration. The demo still runs end to end; it is just less clever.
ANTHROPIC_API_KEY=
KAIROS_LLM_MODEL=claude-sonnet-5

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=kairos
POSTGRES_PASSWORD=kairos
POSTGRES_DB=kairos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MLflow ----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=kairos

# --- API -------------------------------------------------------------------
KAIROS_ENV=dev
KAIROS_LOG_LEVEL=INFO
KAIROS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Host port map (see docker-compose.yml) --------------------------------
# api 8000 | web 5173 | postgres 5433 | mlflow 5001  (5000 is AirPlay on macOS)
